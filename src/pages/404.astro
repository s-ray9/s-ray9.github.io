---
import Primitive from "@components/ui/Primitive.astro";
import Layout from "@layouts/Layout.astro";
---

<Layout title="404 Not Found">
  <section
    class="mx-auto flex max-w-xl flex-col items-center gap-4 text-center"
  >
    <h1>404</h1>

    <span class="text-xs font-bold uppercase tracking-widest text-accent">
      Not Found
    </span>

    <p class="text-fg-secondary">
      Sorry, we couldn't find the page you were looking for.
    </p>

    <div class="w-full">
      <Primitive
        as="a"
        href="/"
        class="inline-block cursor-pointer rounded-xl border border-border px-8 py-4 text-sm font-medium tracking-tight text-fg-secondary hover:text-fg-primary hover:text-accent"
      >
        Back home
      </Primitive>
    </div>
  </section>
</Layout>
